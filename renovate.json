{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "enabled": false,
      "matchPackageNames": [
        "dev.galasa:*"
      ]
    },
    {
      "matchFileNames": ["docs/requirements.txt"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "docs"
    }
  ]
}
